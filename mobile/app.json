{
  "expo": {
    "name": "Xnoll",
    "slug": "xnoll",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "xnoll",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.xnoll.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12151f"
      },
      "package": "com.xnoll.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
